# Test target image: SSH server + OpenJDK + sample Java app
# Used by docker-compose.test.yml for self-contained integration tests.

FROM eclipse-temurin:21-jdk-jammy

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-server \
    curl \
    ca-certificates \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Create test user
RUN useradd -m -s /bin/bash testuser && \
    mkdir -p /home/testuser/.ssh /run/sshd && \
    chown -R testuser:testuser /home/testuser

# Configure SSH: allow password auth, no PAM
RUN sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    sed -i 's/UsePAM yes/UsePAM no/' /etc/ssh/sshd_config && \
    echo "PermitRootLogin no" >> /etc/ssh/sshd_config

# Download math-game.jar as sample Java application
RUN curl -fsSL -o /opt/math-game.jar \
    'https://arthas.aliyun.com/math-game.jar' || \
    curl -fsSL -o /opt/math-game.jar \
    'https://github.com/alibaba/arthas/raw/master/arthas-demo/src/main/java/demo/math-game.jar'

# Download Arthas for offline install testing
RUN curl -fsSL -o /tmp/arthas-bin.zip \
    'https://arthas.aliyun.com/download/latest_version?mirror=aliyun' && \
    mkdir -p /tmp/arthas-all && \
    unzip -q -d /tmp/arthas-all /tmp/arthas-bin.zip && \
    rm /tmp/arthas-bin.zip

COPY --chmod=755 <<'EOF' /entrypoint.sh
#!/bin/bash
set -e

# Set test user password from environment
if [ -n "$SSH_PASSWORD" ]; then
    echo "testuser:$SSH_PASSWORD" | chpasswd
fi

# Start SSH daemon
/usr/sbin/sshd

# Start sample Java application as testuser
su - testuser -c "nohup java -jar /opt/math-game.jar > /dev/null 2>&1 &"

# Verify Java process started
sleep 2
if pgrep -f math-game >/dev/null; then
    echo "math-game.jar started successfully"
else
    echo "WARNING: math-game.jar may not have started"
fi

# Keep container alive
tail -f /dev/null
EOF

EXPOSE 22
ENTRYPOINT ["/entrypoint.sh"]
