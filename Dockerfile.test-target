# Test target image: SSH server + OpenJDK + sample Java app
# Used by docker-compose.test.yml for self-contained integration tests.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Install OpenJDK 21, SSH server, and utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-21-jdk \
    openssh-server \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create test user (password set at runtime via env var)
RUN useradd -m -s /bin/bash testuser && \
    mkdir -p /home/testuser/.ssh && \
    chown -R testuser:testuser /home/testuser

# Configure SSH
RUN mkdir -p /run/sshd && \
    sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin no/' /etc/ssh/sshd_config && \
    sed -i 's/UsePAM yes/UsePAM no/' /etc/ssh/sshd_config

# Download math-game.jar as sample Java application
RUN curl -L -o /opt/math-game.jar \
    'https://github.com/alibaba/arthas/raw/master/arthas-demo/src/main/java/demo/math-game.jar' \
    || curl -L -o /opt/math-game.jar \
    'https://arthas.aliyun.com/math-game.jar'

# Download Arthas for offline install testing
RUN curl -L -o /tmp/arthas-bin.zip \
    'https://arthas.aliyun.com/download/latest_version?mirror=aliyun' \
    && mkdir -p /tmp/arthas-all \
    && unzip -q -d /tmp/arthas-all /tmp/arthas-bin.zip \
    && rm /tmp/arthas-bin.zip

# Startup script: set password, start SSH, start Java app
RUN cat > /entrypoint.sh << 'EOF'
#!/bin/bash
set -e

# Set test user password from environment
if [ -n "$SSH_PASSWORD" ]; then
    echo "testuser:$SSH_PASSWORD" | chpasswd
fi

# Start SSH daemon
/usr/sbin/sshd

# Start sample Java application as testuser
su - testuser -c "java -jar /opt/math-game.jar &"

# Keep container alive
tail -f /dev/null
EOF
RUN chmod +x /entrypoint.sh

EXPOSE 22
ENTRYPOINT ["/entrypoint.sh"]
